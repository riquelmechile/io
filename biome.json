{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**/*.ts",
      "test/**/*.ts",
      "*.ts",
      "*.json",
      "packages/trust-kernel/src/**/*.ts",
      "packages/trust-kernel/test/**/*.ts",
      "packages/trust-kernel/package.json",
      "packages/database/src/**/*.ts",
      "packages/database/test/**/*.ts",
      "packages/database/package.json",
      "packages/business-domain/src/**/*.ts",
      "packages/business-domain/test/**/*.ts",
      "packages/business-domain/package.json",
      "packages/context/src/**/*.ts",
      "packages/context/test/**/*.ts",
      "packages/context/package.json",
      "packages/llm-client/src/**/*.ts",
      "packages/llm-client/test/**/*.ts",
      "packages/llm-client/package.json",
      "packages/app/src/**/*.ts",
      "packages/app/test/**/*.ts",
      "packages/app/package.json",
      "!.pgdata",
      "!**/.pgdata"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  }
}
